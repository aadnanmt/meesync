{
  "tasks": {
    "start": "deno run -A --env-file scripts/index.ts",
    "run": "deno run -A --env-file scripts/index.ts ./README.md ./stats.json",
    "format": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "setup": "cp .env.example .env || copy .env.example .env && git config core.hooksPath .githooks"
  },
  "fmt": {
    "semiColons": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "useTabs": false
  }
}
